{ 
  "name": "wjcs",
  "version": "1.0.0",
  "description": "文件传输工具 - 支持跨设备文件传输和实时通讯",
  "author": "xiao-wu990",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.wjcs.app",
    "productName": "文件传输工具",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
